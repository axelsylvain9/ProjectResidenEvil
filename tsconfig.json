{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "es2020",
    "module": "commonjs",                        
    "types": ["node", "express"],      
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": false,                           // ← OK pour ignorer les erreurs de typage
    "noImplicitAny": false,                    // ← OK pour ignorer les 'any'
    "exactOptionalPropertyTypes": false,   // ← Désactivé car trop strict
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,  
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,                       // ← Ignore la vérification des .d.ts
    "resolveJsonModule": true,                   // ← Pour importer des fichiers JSON
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],                       // ← Inclut tous les fichiers dans src
  "exclude": ["node_modules", "dist"]
}